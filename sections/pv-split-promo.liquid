{% comment %}
  Section contract.

  Split promotional band: media on one side, text stack on the other. Used for
  the newsletter invitation and campaign call-outs.

  Renders the bundled placeholder asset when no image is selected.

  @example
  <!-- Homepage: "Join the PUREVELL list" -->
{% endcomment %}

<div
  class="pv-split{% if section.settings.media_position == 'right' %} pv-split--reverse{% endif %}"
  style="
    --pv-split-bg: {{ section.settings.background_color }};
    --pv-split-text: {{ section.settings.text_color }};
  "
>
  <div class="pv-split__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          widths: '500,700,900,1200,1400',
          sizes: '(min-width: 750px) 50vw, 100vw',
          alt: section.settings.image.alt,
          class: 'pv-split__img'
      }}
    {% else %}
      <img
        class="pv-split__img"
        src="{{ 'pv-promo.jpg' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="600"
        height="800"
        loading="lazy"
      >
    {% endif %}
  </div>

  <div class="pv-split__content">
    {% if section.settings.kicker != blank %}
      <p class="pv-split__kicker">{{ section.settings.kicker | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="pv-split__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.body != blank %}
      <div class="pv-split__body">{{ section.settings.body }}</div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a class="pv-split__button" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .pv-split {
    display: grid;
    grid-template-columns: 1fr;
    background-color: var(--pv-split-bg, transparent);
    color: var(--pv-split-text, inherit);
  }

  @media screen and (min-width: 750px) {
    .pv-split {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    .pv-split--reverse .pv-split__media {
      order: 2;
    }

    .pv-split--reverse .pv-split__content {
      order: 1;
    }
  }

  .pv-split__media {
    position: relative;
    min-height: 320px;
  }

  .pv-split__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pv-split__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(32px, 5vw, 72px);
  }

  .pv-split__kicker {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .pv-split__heading {
    margin: 0;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.12;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .pv-split__body {
    max-width: 46ch;
    line-height: 1.65;
  }

  .pv-split__body > :first-child {
    margin-block-start: 0;
  }

  .pv-split__body > :last-child {
    margin-block-end: 0;
  }

  .pv-split__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 30px;
    border: 1px solid currentcolor;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .pv-split__button:hover {
    background-color: currentcolor;
    color: var(--pv-split-bg, #fcfbf0);
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-split__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Split promo",
  "class": "ui-test-pv-split",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The list"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Join the PUREVELL list</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Early access to new arrivals, mill stories, and private sales. One letter a month, never more.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join free now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EDEBDF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3B4021"
    }
  ],
  "presets": [
    {
      "name": "Split promo",
      "category": "Storytelling"
    }
  ]
}
{% endschema %}
