{% comment %}
  Section contract.

  Image tile grid used for "shop by category" rows and editorial rows. Each
  block renders one tile: an image with an optional label overlay and an
  optional call-to-action line beneath it.

  When a block has no image selected the bundled placeholder asset is rendered,
  so the section never collapses to an empty box before assets are uploaded.

  @example
  <!-- Homepage: two-up category tiles, then a three-up editorial row -->
{% endcomment %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

{% capture tile_items %}
  {% for block in section.blocks %}
    {% assign placeholder = 'pv-tile-knitwear.jpg' %}
    {% case forloop.index0 %}
      {% when 1 %}{% assign placeholder = 'pv-tile-accessories.jpg' %}
      {% when 2 %}{% assign placeholder = 'pv-tile-home.jpg' %}
      {% when 3 %}{% assign placeholder = 'pv-edit-3.jpg' %}
    {% endcase %}

    <li class="pv-tiles__item" {{ block.shopify_attributes }}>
      <a class="pv-tiles__link" href="{{ block.settings.link | default: '#' }}">
        <span class="pv-tiles__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400,600,800,1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: block.settings.image.alt,
                class: 'pv-tiles__img'
            }}
          {% else %}
            <img
              class="pv-tiles__img"
              src="{{ placeholder | asset_url }}"
              alt="{{ block.settings.label | default: 'PUREVELL' | escape }}"
              width="600"
              height="800"
              loading="lazy"
            >
          {% endif %}
          {% if block.settings.label != blank %}
            <span class="pv-tiles__label">{{ block.settings.label }}</span>
          {% endif %}
        </span>
        {% if block.settings.cta_label != blank %}
          <span class="pv-tiles__cta">{{ block.settings.cta_label }}</span>
        {% endif %}
      </a>
    </li>
  {% endfor %}
{% endcapture %}

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
{% if section.settings.heading != blank or section.settings.kicker != blank %}
  <div class="pv-tiles__header">
    {% if section.settings.kicker != blank %}
      <p class="pv-tiles__kicker">{{ section.settings.kicker | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="pv-tiles__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>
{% endif %}

<ul
  class="pv-tiles pv-tiles--{{ section.settings.columns }}-up"
  style="
    --pv-tiles-gap: {{ section.settings.gap }}px;
    --pv-tiles-ratio: {{ section.settings.image_ratio }};
  "
>
  {{ tile_items }}
</ul>
</div>

{% stylesheet %}
  .pv-tiles {
    display: grid;
    gap: var(--pv-tiles-gap, 16px);
    grid-template-columns: repeat(1, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .pv-tiles--2-up {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pv-tiles--3-up {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pv-tiles--4-up {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .pv-tiles__header {
    text-align: center;
    margin-block-end: 12px;
  }

  .pv-tiles__kicker {
    margin: 0 0 6px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .pv-tiles__heading {
    margin: 0;
  }

  .pv-tiles__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .pv-tiles__media {
    position: relative;
    display: block;
    aspect-ratio: var(--pv-tiles-ratio, 4 / 5);
    overflow: hidden;
  }

  .pv-tiles__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .pv-tiles__link:hover .pv-tiles__img {
    transform: scale(1.03);
  }

  .pv-tiles__label {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 18px 16px;
    text-align: center;
    color: #fcfbf0;
    font-size: clamp(1rem, 2vw, 1.5rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgb(0 0 0 / 35%);
  }

  .pv-tiles__cta {
    display: block;
    margin-block-start: 12px;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-tiles__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image tiles",
  "class": "ui-test-pv-tiles",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label overlay"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Call to action",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "16 / 9", "label": "Landscape (16:9)" },
        { "value": "3 / 1", "label": "Banner (3:1)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Image tiles",
      "category": "Storytelling",
      "settings": {
        "columns": "2",
        "image_ratio": "4 / 5",
        "gap": 16
      },
      "blocks": {
        "tile_1": {
          "type": "tile",
          "settings": {
            "label": "Knitwear",
            "cta_label": "Shop now",
            "link": "shopify://collections/knitwear"
          }
        },
        "tile_2": {
          "type": "tile",
          "settings": {
            "label": "Accessories",
            "cta_label": "Shop now",
            "link": "shopify://collections/accessories"
          }
        }
      },
      "block_order": ["tile_1", "tile_2"]
    }
  ]
}
{% endschema %}
