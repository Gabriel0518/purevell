{% comment %}
  Section contract.

  Editorial footer: a newsletter invitation across the top, then up to five link
  columns on a warm ground, closing with a legal bar.

  Columns read from link list pickers so merchants reorder links in Navigation.

  @example
  <!-- Footer group: newsletter + About us / Join us / Need help / Connect -->
{% endcomment %}

<div
  class="pv-footer spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --pv-footer-bg: {{ section.settings.background_color }};
    --pv-footer-text: {{ section.settings.text_color }};
    --pv-footer-columns: {{ section.blocks.size | at_least: 1 }};
  "
>
  <div class="pv-footer__inner">
    <div class="pv-footer__top">
      <div class="pv-footer__newsletter" id="newsletter">
        {% if section.settings.heading != blank %}
          <p class="pv-footer__newsletter-heading">{{ section.settings.heading | escape }}</p>
        {% endif %}
        {% if section.settings.subtext != blank %}
          <p class="pv-footer__newsletter-text">{{ section.settings.subtext | escape }}</p>
        {% endif %}

        {% form 'customer', class: 'pv-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="pv-footer-email-{{ section.id }}">
            {{ section.settings.placeholder | default: 'Email address' | escape }}
          </label>
          <input
            id="pv-footer-email-{{ section.id }}"
            class="pv-footer__input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="{{ section.settings.placeholder | default: 'Email address' | escape }}"
            required
          >
          <button class="pv-footer__submit" type="submit">
            {{ section.settings.button_label | default: 'Sign up' | escape }}
          </button>
        {% endform %}
      </div>

      <nav class="pv-footer__columns" aria-label="Footer">
        {% for block in section.blocks %}
          <div class="pv-footer__column" {{ block.shopify_attributes }}>
            {% if block.settings.title != blank %}
              <p class="pv-footer__column-title">{{ block.settings.title | escape }}</p>
            {% endif %}
            {% if block.settings.menu != blank %}
              <ul class="pv-footer__links">
                {% for link in block.settings.menu.links %}
                  <li>
                    <a class="pv-footer__link" href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endfor %}
      </nav>
    </div>

    <div class="pv-footer__bottom">
      <p class="pv-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
      </p>
      <ul class="pv-footer__legal">
        {% for policy in shop.policies %}
          {% if policy != blank %}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

{% stylesheet %}
  .pv-footer {
    background-color: var(--pv-footer-bg, transparent);
    color: var(--pv-footer-text, inherit);
  }

  .pv-footer__inner {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding-inline: 16px;
  }

  @media screen and (min-width: 750px) {
    .pv-footer__inner {
      padding-inline: 40px;
    }
  }

  .pv-footer__top {
    display: grid;
    gap: 40px;
    padding-block-end: 40px;
  }

  @media screen and (min-width: 990px) {
    .pv-footer__top {
      grid-template-columns: minmax(260px, 1fr) 2.4fr;
      gap: 64px;
      padding-block-end: 56px;
    }
  }

  .pv-footer__newsletter-heading {
    margin: 0 0 8px;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pv-footer__newsletter-text {
    margin: 0 0 18px;
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.75;
  }

  .pv-footer__form {
    display: flex;
    align-items: stretch;
    gap: 0;
    max-width: 380px;
    border-block-end: 1px solid currentcolor;
  }

  .pv-footer__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 12px 0;
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
  }

  .pv-footer__input::placeholder {
    color: currentcolor;
    opacity: 0.55;
  }

  .pv-footer__submit {
    flex: 0 0 auto;
    padding: 12px 4px;
    background: none;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: inherit;
  }

  .pv-footer__submit:hover {
    opacity: 0.7;
  }

  .pv-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 24px;
  }

  @media screen and (min-width: 750px) {
    .pv-footer__columns {
      grid-template-columns: repeat(var(--pv-footer-columns, 4), minmax(0, 1fr));
      gap: 24px;
    }
  }

  .pv-footer__column-title {
    margin: 0 0 14px;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .pv-footer__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pv-footer__link {
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.4;
    opacity: 0.9;
  }

  .pv-footer__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    opacity: 1;
  }

  .pv-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    opacity: 0.75;
  }

  .pv-footer__copyright {
    margin: 0;
  }

  .pv-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pv-footer__legal a {
    color: inherit;
    text-decoration: none;
  }

  .pv-footer__legal a:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial footer",
  "class": "ui-test-pv-footer",
  "max_blocks": 5,
  "enabled_on": {
    "groups": ["footer"]
  },
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "About us"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Newsletter heading",
      "default": "Sign up for $10 off your first order"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Newsletter text",
      "default": "Early access to new arrivals, mill stories, and private sales."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EDEBDF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3B4021"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Editorial footer",
      "blocks": {
        "col_1": { "type": "column", "settings": { "title": "About us", "menu": "footer-about" } },
        "col_2": { "type": "column", "settings": { "title": "Join us", "menu": "footer-join" } },
        "col_3": { "type": "column", "settings": { "title": "Need help?", "menu": "footer-help" } },
        "col_4": { "type": "column", "settings": { "title": "Connect", "menu": "footer-connect" } }
      },
      "block_order": ["col_1", "col_2", "col_3", "col_4"]
    }
  ]
}
{% endschema %}
