{% comment %}
  Inline PUREVELL wordmark.

  Rendered as inline SVG rather than an image so it inherits `currentColor`
  from the header and stays crisp while the header switches between its solid
  and transparent-over-hero states.

  @example
  {% render 'pv-logo' %}
{% endcomment %}

<svg
  class="pv-logo"
  viewBox="0 0 268 32"
  role="img"
  aria-label="PUREVELL"
  preserveAspectRatio="xMidYMid meet"
  focusable="false"
>
  <text
    class="pv-logo__text"
    x="134"
    y="23"
    text-anchor="middle"
    fill="currentColor"
    aria-hidden="true"
  >
    PUREVELL
  </text>
</svg>

{% stylesheet %}
  .pv-logo {
    display: block;
    width: auto;
    height: 22px;
    overflow: visible;
  }

  .pv-logo__text {
    font-family: var(--font-body--family, sans-serif);
    font-size: 26px;
    font-weight: 500;
    letter-spacing: 0.22em;
    /* SVG text ignores text-transform, so the mark is authored in caps. */
  }

  @media screen and (min-width: 750px) {
    .pv-logo {
      height: 24px;
    }
  }
{% endstylesheet %}
